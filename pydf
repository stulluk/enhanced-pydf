def _read_sysfs_text(path):
    try:
        with open(path, "rb") as f:
            return _decode_subprocess_output(f.read()).strip()
    except (OSError, IOError):
        return ""


def _pcie_gen_from_gt_line(gt_line):
    "Map max_link_speed line (e.g. '16.0 GT/s PCIe') to a generation label."
    m = re.match(r"([\d.]+)", gt_line.strip())
    if not m:
        return "?"
    v = float(m.group(1))
    if v < 4.0:
        return "1"
    if v < 6.0:
        return "2"
    if v < 10.0:
        return "3"
    if v < 20.0:
        return "4"
    return "5"


# Approximate PCIe 3.0+ effective data rate per lane (one direction), GB/s
# (128b/130b encoding). Gen1/2 use 8b/10b; values are rounded references only.
_PCIE_LANE_GBPS = {
    "1": 0.250,
    "2": 0.500,
    "3": 0.985,
    "4": 1.969,
    "5": 3.938,
}


def _pcie_approx_throughput_label(gen_str, lanes_str):
    "Static-table style ~GB/s hint for Gen x lanes (theoretical, one direction)."
    try:
        lanes_i = int(str(lanes_str).strip())
    except ValueError:
        return ""
    gbps_lane = _PCIE_LANE_GBPS.get(gen_str)
    if gbps_lane is None:
        return ""
    total = gbps_lane * lanes_i
    if total >= 10.0:
        return "~%.0f GB/s" % round(total)
    if total >= 1.0:
        return "~%.1f GB/s" % round(total, 1)
    return "~%.2f GB/s" % total


def _sata_sysfs_link_speed_raw(block_basename):
    "Read kernel sata_spd via scsi_host port_no or unique_id -> ata linkN; else single-link fallback."
    if block_basename in _sata_spd_cache:
        return _sata_spd_cache[block_basename]
    raw = ""
    dev_p = "/sys/block/%s/device" % block_basename
    if re.match(r"^sd[a-z]+$", block_basename) and os.path.exists(dev_p):
        sd_dev = os.path.realpath(dev_p)
        hm = re.search(r"/host(\d+)/", sd_dev)
        if hm:
            host_n = hm.group(1)
            sh_base = "/sys/class/scsi_host/host%s" % host_n
            port = _read_sysfs_text(os.path.join(sh_base, "port_no")).strip()
            if not port.isdigit():
                port = _read_sysfs_text(os.path.join(sh_base, "unique_id")).strip()
            if port.isdigit():
                idx = sd_dev.find("/host%s/" % host_n)
                if idx > 0:
                    ata_dir = sd_dev[:idx]
                    link_tag = "link%s" % port
                    spd_p = os.path.join(
                        ata_dir, link_tag, "ata_link", link_tag, "sata_spd"
                    )
                    if os.path.isfile(spd_p):
                        raw = _read_sysfs_text(spd_p)
            if not raw:
                mata = re.search(r"(.*)/host\d+/target", sd_dev)
                if mata:
                    ata_dir = mata.group(1)
                    link_dirs = []
                    try:
                        for name in os.listdir(ata_dir):
                            if name.startswith("link") and name[4:].isdigit():
                                lt = name
                                spd_p = os.path.join(
                                    ata_dir, lt, "ata_link", lt, "sata_spd"
                                )
                                if os.path.isfile(spd_p):
                                    v = _read_sysfs_text(spd_p)
                                    if v and v != "<unknown>":
                                        link_dirs.append(v)
                    except OSError:
                        pass
                    if len(link_dirs) == 1:
                        raw = link_dirs[0]
    _sata_spd_cache[block_basename] = raw
    return raw


def _sata_link_speed_display(block_basename):
    "Human-readable SATA link from sysfs; no fixed 6 Gb/s assumption."
    line = _sata_sysfs_link_speed_raw(block_basename)
    if not line or line == "<unknown>":
        return "link n/a"
    m = re.match(r"([\d.]+)", line)
    if not m:
        return line
    gbps = float(m.group(1))
    if gbps <= 1.6:
        gen = "I"
    elif gbps <= 3.1:
        gen = "II"
    elif gbps <= 6.1:
        gen = "III"
    else:
        gen = ""
    if gen:
        return "%s (SATA %s)" % (line.strip(), gen)
    return line.strip()


def _nvme_link_max_summary(block_basename):
    "PCIe max link from sysfs for nvmeXnY -> nvmeX, plus static ~GB/s hint."
    m = re.match(r"(nvme\d+)n\d+", block_basename)
    if not m:
        return ""
    ctrl = m.group(1)
    base = "/sys/class/nvme/%s/device" % ctrl
    spd = _read_sysfs_text(os.path.join(base, "max_link_speed"))
    wid = _read_sysfs_text(os.path.join(base, "max_link_width"))
    if not spd or not wid:
        return ""
    gen = _pcie_gen_from_gt_line(spd)
    core = "PCIe Gen%s x%s" % (gen, wid.strip())
    approx = _pcie_approx_throughput_label(gen, wid)
    if approx:
        return "%s (%s)" % (core, approx)
    return core


def _usb_speed_mbps(block_basename):
    "Walk sysfs up from /sys/block/sdX/device to find USB speed (Mbps)."
    if not re.match(r"^sd[a-z]+$", block_basename):
        return None
    dev_l = "/sys/block/%s/device" % block_basename
    if not os.path.exists(dev_l):
        return None
    cur = os.path.realpath(dev_l)
    for _dummy in range(20):
        sp = os.path.join(cur, "speed")
        if os.path.isfile(sp):
            txt = _read_sysfs_text(sp)
            if txt.isdigit():
                return int(txt)
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return None


def _usb_speed_nominal_gbps(mbps):
    "Rough theoretical headline rate from USB speed file (Mbps)."
    if mbps <= 12:
        return "USB 1.x"
    if mbps <= 480:
        return "USB 2 (480 Mb/s)"
    if mbps <= 5000:
        return "~5 Gb/s"
    if mbps <= 10000:
        return "~10 Gb/s"
    if mbps <= 20000:
        return "~20 Gb/s"
    return "~40+ Gb/s"


def _theoretical_link_speed(tran_l, backend_dev):
    "Nominal interface speed; sysfs only where it is a few file reads."
    bn = os.path.basename(os.path.realpath(backend_dev))
    if tran_l == "nvme":
        s = _nvme_link_max_summary(bn)
        return s if s else "NVMe"
    if tran_l == "sata":
        return _sata_link_speed_display(bn)
    if tran_l == "usb":
        mbps = _usb_speed_mbps(bn)
        if mbps is not None:
            return _usb_speed_nominal_gbps(mbps)
        return "~5 Gb/s"
    if tran_l == "sas":
        return "12 Gb/s"
    if tran_l in ("iscsi", "fc"):
        return "-"
    if tran_l:
        return "-"
    return "-"


def _disk_model_sysfs(dev_path):
    "Read vendor/model from sysfs for the backing block device."
    bn = _kernel_block_disk_name(dev_path)
    if not bn:
        return "-"
    vendor_p = "/sys/block/%s/device/vendor" % bn
    model_p = "/sys/block/%s/device/model" % bn
    vendor, model = "", ""
    try:
        if os.path.isfile(vendor_p):
            with open(vendor_p, "rb") as f:
                vendor = _decode_subprocess_output(f.read()).strip()
    except (OSError, IOError):
        pass
    try:
        if os.path.isfile(model_p):
            with open(model_p, "rb") as f:
                model = _decode_subprocess_output(f.read()).strip()
    except (OSError, IOError):
        pass
    parts = []
    for p in (vendor, model):
        if p:
            parts.append(" ".join(p.split()))
    combined = " ".join(parts) if parts else "-"
    return _unescape_udev_enc(combined) if combined != "-" else combined


def _backend_pci_bdf(backend_dev):
    "PCI domain:BDF for the storage endpoint (NVMe sysfs address, else last BDF in block device path)."
    bn = os.path.basename(os.path.realpath(backend_dev))
    m = re.match(r"(nvme\d+)n\d+", bn)
    if m:
        addr_f = "/sys/class/nvme/%s/address" % m.group(1)
        if os.path.isfile(addr_f):
            txt = _read_sysfs_text(addr_f)
            if txt:
                return txt
    dev_l = "/sys/block/%s/device" % bn
    if not os.path.exists(dev_l):
        return "-"
    try:
        rp = os.path.realpath(dev_l)
    except OSError:
        return "-"
    parts = re.findall(
        r"([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.\d)", rp, re.I
    )
    if parts:
        return parts[-1]
    return "-"


def disk_row_extras(device_raw, fstype):
    "Return (disk_label, pci_bdf, bus_label, theoretical_link); cached per rpath."
    blank = ("-", "-", "-", "-")
    if is_remote_fs(fstype):
        return blank
    if not device_raw or not device_raw.startswith("/dev/"):
        return blank
    try:
        rpath = os.path.realpath(device_raw)
    except OSError:
        rpath = device_raw
    if rpath in _disk_info_cache:
        return _disk_info_cache[rpath]
    if not os.path.exists(rpath):
        _disk_info_cache[rpath] = blank
        return blank
    backend = _disk_backend_dev_path(rpath)
    vendor, model, tran = _lsblk_vendor_model_tran(backend)
    disk_l = _format_vendor_model_label(vendor, model, rpath)
    tran_l = (tran or "").strip().lower()
    bn = os.path.basename(os.path.realpath(backend))
    if not tran_l:
        tran_l = _infer_tran_from_basename(bn)
    pci_l = _backend_pci_bdf(backend)
    iface_l = _iface_display(tran_l)
    spd_l = _theoretical_link_speed(tran_l, backend)
    row = (disk_l, pci_l, iface_l, spd_l)
    _disk_info_cache[rpath] = row
    return row


def disk_vendor_model(device_raw, fstype):
    "Return vendor/model only (for compatibility); see disk_row_extras."
    return disk_row_extras(device_raw, fstype)[0]


def get_row_mp(mp):
    # for python3, mp is bytes, not str
    if mp:
        if mp in mountpoints:
            device_raw, fstype, opts = mountpoints[mp]
            device = niceprint_fs(device_raw)
        else:
            # oops, the mountpoint is not in /etc/mtab or equivalent
            # return dummy values
            device_raw, fstype, opts = '-', '-', '-'
            device = device_raw
        rdonly = 'ro' in opts or fstype in  ("iso9660", "udf")
        bind = 'bind' in opts or 'rbind' in opts

        try:
            status = os.statvfs(mp)
        except (OSError, IOError):
            status = DumbStatus()
        fs_blocksize = status.f_bsize
        if fs_blocksize == 0:
            fs_blocksize = status.f_frsize
        free = status.f_bfree
        size = status.f_blocks
        avail = status.f_bavail
        inodes_free = status.f_ffree
        inodes_size = status.f_files
        inodes_avail = status.f_favail
        if (size==0 or is_special_fs(fstype)) and not allfss:
            return
        if bind and hidebinds:
            return
        used = size-free
        inodes_used = inodes_size - inodes_free

        if inodes:
            capacity = inodes_size
            size_f = myformat(inodes_size, sizeformat, 1)
            used_f = myformat(inodes_used, sizeformat, 1)
            avail_f = myformat(inodes_avail, sizeformat, 1)
            try:
                perc = round(100.*inodes_used/inodes_size, 1)
                perc_f = str(perc)
            except ZeroDivisionError:
                perc = 0
                perc_f = '-'
        else:
            capacity = size*fs_blocksize
            size_f = myformat(size, sizeformat, fs_blocksize)
            used_f = myformat(used, sizeformat, fs_blocksize)
            avail_f = myformat(avail, sizeformat, fs_blocksize)
            try:
                perc = round(100.*used/size, 1)
                perc_f = str(perc)
            except ZeroDivisionError:
                perc = 0
                perc_f = '-'


        dsk_l, pci_l, if_l, sp_l = disk_row_extras(device_raw, fstype)
        info = {
            'fs'     :    device,
            'disk'   :    dsk_l,
            'pci'    :    pci_l,
            'iface'  :    if_l,
            'speed'  :    sp_l,
            'size'   :    size_f,
            'used'   :    used_f,
            'avail'  :    avail_f,
            'on'     :    mp,
            'fstype' :    fstype,
            'perc'   :    perc_f,
            'bar'    :    None,
                }
        current_colour = local_fs_colour
        if is_remote_fs(fstype):
            current_colour = remote_fs_colour
        elif size == 0 or is_special_fs(fstype):
            current_colour = special_fs_colour
    else: # header
        current_colour = header_colour

    row = []

    for j in format:

        if j[0]=='bar':
            width = j[1]
            if 0<width<1: # i.e. percentage
                width = int(width*terminal_width)-1

        if mp:
            if j[0] in ['perc', 'avail', 'bar']:
                if rdonly:
                    current_colour = readonly_fs_colour
                elif perc > FULL_THRESH:
                    current_colour = full_fs_colour
                elif perc > FILL_THRESH:
                    current_colour = filled_fs_colour
            if j[0]=='bar':
                info['bar'] = Bar(perc/100., width, capacity=capacity)

            text = info[j[0]]
            # if there are control or invalid unicode characters in mountpoint names
            if not isinstance(text, Bar):
                text = sanitize_output(text)

        else:
            text = header[j[0]]
            if j[0]=='bar':
                text.width = width

        column = [current_colour, text]
        row.append(column)

    return row


def is_remote_fs(fs):
    "test if fs (as type) is a remote one"
    fs = fs.lower()

    return fs in [ "nfs", "smbfs", "cifs", "ncpfs", "afs", "coda",
                  "ftpfs", "mfs", "sshfs", "fuse.sshfs", "nfs4" ]

def is_special_fs(fs):
    "test if fs (as type) is a special one"
    "in addition, a filesystem is special if it has number of blocks equal to 0"
    fs = fs.lower()
    return fs in [ "tmpfs", "devpts", "devtmpfs", "proc", "sysfs", "usbfs", "devfs", "fdescfs", "linprocfs" ]

def get_table(mps):
    "table is a list of rows"
    "row is a list of columns"
    "column is a list of [colour code, content]"
    "content is a string, unless it is a Bar() instance"
    rows = [get_row_mp(None)]
    for mp in mps:
        row = get_row_mp(mp)
        if row is not None:
            rows.append(row)
    scale_bars(rows[1:])
    return rows


def scale_bars(rows):
    "make bar lengths proportional to the largest filesystem in rows"
    bars = [column[1] for row in rows for column in row if isinstance(column[1], Bar)]
    largest = max([bar.capacity for bar in bars] + [0])
    if largest:
        for bar in bars:
            bar.scale = float(bar.capacity)/largest


def squeeze_table(table, desired_width):
    "squeeze table to fit into width characters"

    cols = len(table[0])

    # build a row of minimal (possible, from format) cell sizes
    minrow = []
    for j in format:
        width = j[1]
        if 0 < width < 1: # i.e. percentage
            width = int(width*terminal_width)-1
        minrow.append(width)

    # row of maximal cell sizes 
    maxrow = [0]*cols

    for row in table:
        for col in range(cols):
            colsize = len(row[col][1])
            maxrow[col] = max(maxrow[col], colsize)

    # maximal differences between (real cell size - minimal possible cell size)
    deltarow = [maxrow[i]-minrow[i] for i in range(cols)]

    deltas = list(zip(deltarow, list(range(cols))))
    deltas.sort()
    deltas.reverse()

    # how many characters we need to cut off from table width
    to_reduce = sum(maxrow) + (cols-1)*len(column_separator) - desired_width

    to_stretch = 0
    # if there is free space
    if to_reduce < 0 and stretch_screen:
        # -to_reduce is now number of spare characters
        to_stretch = int(-to_reduce * stretch_screen)

    new_maxrow = maxrow[:] # new sizes
    for delta, i in deltas:
        if to_reduce < 0:
            # we have finished
            break
        if delta >= to_reduce:
            new_maxrow[i] -= to_reduce
            # and we finished
            to_reduce = 0
            break
        else:
            new_maxrow[i] -= delta # now it contains the minimal possible width
            to_reduce -= delta

    if to_reduce > 0:
        # we were not able to reduce the size enough
        # since it will wrap anywway, we might as well display 
        # complete long lines
        new_maxrow = maxrow
    for row in table:
        for col in range(cols):
            cell_content = row[col][1]
            if isinstance(cell_content, Bar):
                cell_content.width += to_stretch
                formatted_cell_content = cell_content.format(format[col][2])
            else:
                formatted_cell_content = manglestring(cell_content, new_maxrow[col], format[col][2])
            row[col][1] = formatted_cell_content


def display_table(table, terminal_width):
    "display our internal output table"

    squeeze_table(table, terminal_width-1)

    colsepcol = makecolour(column_separator_colour)
    for row in table:
        firstcol = True
        for colourcode, text in row:
            if firstcol:
                firstcol = False
            else:
                out(colsepcol)
                out(column_separator)
            out(makecolour(colourcode))
            out(text)
        out(row_separator)
        out(makecolour(normal_colour))
        out('\n')



