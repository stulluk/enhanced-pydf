def _decode_subprocess_output(out):
    "Normalize bytes output from subprocess to a unicode/str line."
    if sys.version_info[0] >= 3 and isinstance(out, bytes):
        return out.decode(sys.getfilesystemencoding() or "utf-8", "replace")
    return out


def _unescape_udev_enc(s):
    "Turn udev-style \\xNN sequences in lsblk output into real characters."
    def repl(match):
        return chr(int(match.group(1), 16))

    return re.sub(r"\\x([0-9a-fA-F]{2})", repl, s)


def _kernel_block_disk_name(dev_path):
    "Return top-level block device name (e.g. sda, nvme0n1) for dev_path."
    if dev_path in _pkname_cache:
        return _pkname_cache[dev_path]
    try:
        import subprocess
        out = subprocess.check_output(
            ["lsblk", "-dnr", "-o", "PKNAME", dev_path],
            stderr=subprocess.STDOUT,
        )
    except (subprocess.CalledProcessError, OSError):
        base = os.path.basename(os.path.realpath(dev_path))
        _pkname_cache[dev_path] = base or None
        return _pkname_cache[dev_path]
    line = _decode_subprocess_output(out).strip().split("\n")
    parent = line[0].strip() if line else ""
    if parent:
        _pkname_cache[dev_path] = parent
        return parent
    base = os.path.basename(os.path.realpath(dev_path))
    _pkname_cache[dev_path] = base or None
    return _pkname_cache[dev_path]


def _disk_backend_dev_path(dev_path):
    "Whole-disk path for lsblk (e.g. /dev/sda for /dev/sda1)."
    pk = _kernel_block_disk_name(dev_path)
    if pk:
        return os.path.join("/dev", pk)
    base = os.path.basename(os.path.realpath(dev_path))
    if base:
        return os.path.join("/dev", base)
    return dev_path


def _lsblk_vendor_model_tran(backend_dev):
    "One lsblk -P call: vendor, model, transport (TRAN); cached per backend."
    if backend_dev in _lsblk_vmt_cache:
        return _lsblk_vmt_cache[backend_dev]
    try:
        import subprocess
        out = subprocess.check_output(
            ["lsblk", "-dnP", "-o", "VENDOR,MODEL,TRAN", backend_dev],
            stderr=subprocess.STDOUT,
        )
    except (subprocess.CalledProcessError, OSError):
        _lsblk_vmt_cache[backend_dev] = ("", "", "")
        return _lsblk_vmt_cache[backend_dev]
    line = _decode_subprocess_output(out).strip().split("\n")[0] if out else ""
    pairs = dict(re.findall(r'([A-Z_]+)="([^"]*)"', line))
    tup = (
        pairs.get("VENDOR", "").strip(),
        pairs.get("MODEL", "").strip(),
        pairs.get("TRAN", "").strip(),
    )
    _lsblk_vmt_cache[backend_dev] = tup
    return tup


def _format_vendor_model_label(vendor, model, rpath_for_sysfs):
    "Build disk label from lsblk fields; fall back to sysfs on the mount device."
    vendor = " ".join(vendor.split())
    model = " ".join(model.split())
    if vendor in ("", "-") and not model:
        return _disk_model_sysfs(rpath_for_sysfs)
    if not model:
        combined = vendor if vendor else _disk_model_sysfs(rpath_for_sysfs)
        if combined == "-":
            return combined
        return _unescape_udev_enc(combined)
    if not vendor or vendor == "-":
        combined = model
    else:
        combined = "%s %s" % (vendor, model)
    return _unescape_udev_enc(combined)


